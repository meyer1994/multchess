    "@trpc/client": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "@vueuse/nuxt": "13.9.0",
    "chess.js": "^1.4.0",
    "langchain": "^0.3.35",
    "memoizee": "^0.4.17",
    "nuxt": "^4.1.3",
    "p-retry": "^7.1.0",
    "stockfish.js": "^10.0.2",
    "trpc-nuxt": "^1.2.0",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "vue3-chessboard": "^1.3.3",
