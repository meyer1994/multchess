{
  "name": "multchess",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "cp -fv node_modules/stockfish.js/stockfish.* public/ && nuxt prepare && pnpm run cf:types",
    "typecheck": "nuxt typecheck",
    "clean": "rm -rfv .data .wrangler .output .nuxt && rm -rf node_modules",
    "cf:deploy": "wrangler --cwd .output deploy --env .env",
    "cf:types": "wrangler types shared/wrangler.d.ts && pnpm exec eslint --fix shared/wrangler.d.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/openai": "^1.5.3",
    "@nuxt/eslint": "1.16.0",
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/tailwindcss": "6.14.0",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@vueuse/nuxt": "14.3.0",
    "chess.js": "^1.4.0",
    "langchain": "^1.5.2",
    "memoizee": "^0.4.17",
    "nuxt": "^4.4.8",
    "p-retry": "^8.0.0",
    "stockfish.js": "^10.0.2",
    "tailwindcss": "^4.3.2",
    "trpc-nuxt": "^2.1.1",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "vue3-chessboard": "^1.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.4.8",
    "@tailwindcss/typography": "^0.5.20",
    "@types/memoizee": "^0.4.12",
    "@types/node": "^26.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.6.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.6",
    "wrangler": "^4.107.0"
  }
}