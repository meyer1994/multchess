  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "cp -fv node_modules/stockfish.js/stockfish.* public/ && pnpm run cf:types && nuxt prepare",
