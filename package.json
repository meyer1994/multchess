{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && cp -fv node_modules/stockfish.js/stockfish.* public/",
    "typecheck": "nuxt typecheck",
    "db:push": "dotenv -e .env -- drizzle-kit push --force",
    "db:drop": "rm -fv .data/db.sqlite",
    "db:reset": "dotenv -e .env -- pnpm db:drop && pnpm db:push"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@nuxt/eslint": "1.9.0",
    "@nuxt/ui": "^3.3.4",
    "@nuxtjs/tailwindcss": "6.14.0",
    "@trpc/client": "^11.5.1",
    "@trpc/server": "^11.5.1",
    "@vueuse/nuxt": "13.9.0",
    "async-lock": "^1.4.1",
    "cheerio": "^1.1.2",
    "drizzle-orm": "^0.44.5",
    "eslint": "^9.34.0",
    "memoizee": "^0.4.17",
    "nuxt": "^4.1.0",
    "openai": "^5.19.1",
    "p-retry": "^7.0.0",
    "pino": "^9.10.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.1",
    "stockfish.js": "^10.0.2",
    "trpc-nuxt": "^1.2.0",
    "vue": "^3.5.20",
    "vue-router": "^4.5.1",
    "vue3-chessboard": "^1.3.3",
    "zod": "^3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.18",
    "@types/async-lock": "^1.4.2",
    "@types/memoizee": "^0.4.12",
    "@types/node": "^24.3.0",
    "dotenv-cli": "^10.0.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.2",
    "vue-tsc": "^3.0.6"
  }
}
