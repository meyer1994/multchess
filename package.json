{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && cp -fv node_modules/stockfish.js/stockfish.* public/",
    "typecheck": "nuxt typecheck",
    "db:push": "dotenv -e .env -- drizzle-kit push --force",
    "db:drop": "rm -fv .data/db.sqlite",
    "db:reset": "dotenv -e .env -- pnpm db:drop && pnpm db:push",
    "cf:deploy": "pnpm run build && wrangler --cwd .output deploy",
    "cf:types": "wrangler types shared/wrangler.d.ts",
    "cf:dev": "wrangler dev",
    "cf:migrate": "wrangler d1 migrations apply foca"
  },
  "dependencies": {
    "@langchain/core": "^0.3.78",
    "@langchain/openai": "^0.6.15",
    "@libsql/client": "^0.15.15",
    "@nuxt/eslint": "1.9.0",
    "@nuxt/ui": "^3.3.6",
    "@nuxtjs/tailwindcss": "6.14.0",
    "@trpc/client": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "@vueuse/nuxt": "13.9.0",
    "eslint": "^9.37.0",
    "langchain": "^0.3.35",
    "memoizee": "^0.4.17",
    "nuxt": "^4.1.3",
    "p-retry": "^7.1.0",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.2",
    "stockfish.js": "^10.0.2",
    "trpc-nuxt": "^1.2.0",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "vue3-chessboard": "^1.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/memoizee": "^0.4.12",
    "@types/node": "^24.7.2",
    "dotenv-cli": "^10.0.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.1",
    "wrangler": "^4.42.2"
  }
}